generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique @db.VarChar(255)
  username       String?   @unique @db.VarChar(100)
  displayName    String?   @db.VarChar(255)
  avatarUrl      String?   @db.Text
  bio            String?   @db.Text
  socialLinks    Json      @default("{}")
  planType       String    @default("free") @db.VarChar(50)
  creditsBalance Int       @default(5)
  isActive       Boolean   @default(true)
  isAdmin        Boolean   @default(false)
  lastActiveAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspaces     Workspace[]
  projects       Project[]
  canvases       Canvas[]
  characters     Character[]
  generationJobs GenerationJob[]
  subscriptions  Subscription[]
  auditLogs      AuditLog[]
  assets         Asset[]
  creditLedger   CreditLedgerEntry[]
  workflowRuns   WorkflowRun[]
  memberships    WorkspaceMember[]

  @@map("users")
}

model Workspace {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(255)
  slug         String   @unique @db.VarChar(255)
  ownerId      String?  @db.Uuid
  logoUrl      String?  @db.Text
  brandColor   String?  @db.VarChar(7)
  customDomain String?  @db.VarChar(255)
  isWhiteLabel Boolean  @default(false)
  settings     Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner      User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  projects   Project[]
  characters Character[]
  auditLogs  AuditLog[]
  assets     Asset[]
  workflows  Workflow[]
  members    WorkspaceMember[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  userId      String   @db.Uuid
  role        String   @default("member") @db.VarChar(30)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, role])
  @@map("workspace_members")
}

model Project {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String?  @db.Uuid
  name         String   @db.VarChar(255)
  description  String?  @db.Text
  thumbnailUrl String?  @db.Text
  status       String   @default("draft") @db.VarChar(50)
  settings     Json     @default("{}")
  createdById  String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace      Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy      User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  canvases       Canvas[]
  generationJobs GenerationJob[]
  assets         Asset[]
  workflows      Workflow[]

  @@index([workspaceId, updatedAt])
  @@map("projects")
}

model Canvas {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String?  @db.Uuid
  name        String   @db.VarChar(255)
  nodes       Json     @default("[]")
  edges       Json     @default("[]")
  viewport    Json     @default("{\"x\": 0, \"y\": 0, \"zoom\": 1}")
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById, updatedAt])
  @@map("canvases")
}

model Character {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String?  @db.Uuid
  name            String   @db.VarChar(255)
  referenceImages Json     @default("[]")
  trainedModelId  String?  @db.VarChar(255)
  trainingStatus  String   @default("untrained") @db.VarChar(50)
  consentStatus   String   @default("pending") @db.VarChar(50)
  provenanceNotes String?  @db.Text
  settings        Json     @default("{}")
  createdById     String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, trainingStatus])
  @@map("characters")
}

model GenerationJob {
  id              String    @id @default(uuid()) @db.Uuid
  projectId       String?   @db.Uuid
  userId          String?   @db.Uuid
  modelId         String    @db.VarChar(255)
  inputType       String?   @db.VarChar(50)
  inputData       Json      @default("{}")
  parameters      Json      @default("{}")
  status          String    @default("pending") @db.VarChar(50)
  resultUrls      Json      @default("[]")
  errorMessage    String?   @db.Text
  creditsUsed     Int       @default(0)
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  expiresAt       DateTime?
  idempotencyKey  String?   @db.VarChar(255)
  providerJobId   String?   @db.VarChar(255)
  retryCount      Int       @default(0)
  reservedCredits Int       @default(0)

  project       Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user          User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  ledgerEntries CreditLedgerEntry[]

  @@unique([userId, idempotencyKey])
  @@index([userId, status])
  @@map("generation_jobs")
}

model Asset {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String?  @db.Uuid
  projectId   String?  @db.Uuid
  createdById String?  @db.Uuid
  kind        String   @db.VarChar(50)
  name        String   @db.VarChar(255)
  storageKey  String   @db.Text
  mimeType    String?  @db.VarChar(120)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, kind])
  @@index([projectId, createdAt])
  @@map("assets")
}

model CreditLedgerEntry {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  generationJobId String?  @db.Uuid
  type            String   @db.VarChar(30)
  amount          Int
  balanceAfter    Int
  reason          String?  @db.Text
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  generationJob GenerationJob? @relation(fields: [generationJobId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("credit_ledger_entries")
}

model Workflow {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String?  @db.Uuid
  projectId   String?  @db.Uuid
  name        String   @db.VarChar(255)
  type        String   @db.VarChar(50)
  definition  Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs      WorkflowRun[]

  @@index([workspaceId, type])
  @@map("workflows")
}

model WorkflowRun {
  id          String    @id @default(uuid()) @db.Uuid
  workflowId  String    @db.Uuid
  userId      String    @db.Uuid
  status      String    @default("queued") @db.VarChar(40)
  inputData   Json      @default("{}")
  outputData  Json      @default("{}")
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("workflow_runs")
}

model Subscription {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @db.Uuid
  planId               String    @db.VarChar(50)
  status               String    @default("active") @db.VarChar(50)
  creditsAllowance     Int?
  billingCycle         String?   @db.VarChar(20)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  stripeSubscriptionId String?   @db.VarChar(255)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String?  @db.Uuid
  userId       String?  @db.Uuid
  action       String   @db.VarChar(100)
  resourceType String?  @db.VarChar(50)
  resourceId   String?  @db.Uuid
  details      Json     @default("{}")
  ipAddress    String?  @db.Inet
  userAgent    String?  @db.Text
  createdAt    DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
