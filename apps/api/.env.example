# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres?sslmode=disable

# Supabase Authentication
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# API runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Frontend uses this public URL when authenticating and calling the API
# NEXT_PUBLIC_API_URL=http://localhost:3001

# Durable job worker
QUEUE_DRIVER=database
QUEUE_POLL_INTERVAL_MS=5000
JOB_MAX_RETRIES=3
JOB_LEASE_SECONDS=120

# Private object storage (implement the adapter before enabling uploads)
STORAGE_PROVIDER=s3
S3_ENDPOINT=https://your-storage-endpoint
S3_REGION=auto
S3_BUCKET=cineforge-private
S3_ACCESS_KEY_ID=your-storage-access-key
S3_SECRET_ACCESS_KEY=your-storage-secret
S3_SIGNED_URL_TTL_SECONDS=900

# Provider credentials: keep these only in the deployment secret manager.
# The shipped catalogue remains staged until a typed adapter is registered,
# credentials are verified, and the model is explicitly approved.
OPENAI_API_KEY=replace-with-secret-manager-reference
GOOGLE_AI_API_KEY=replace-with-secret-manager-reference
KLING_API_KEY=replace-with-secret-manager-reference
BYTEDANCE_API_KEY=replace-with-secret-manager-reference
WAN_API_KEY=replace-with-secret-manager-reference
BFL_API_KEY=replace-with-secret-manager-reference
